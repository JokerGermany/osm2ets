// osm2ets-writer – Zuordnung OSM-Attribute → ETS2-Straßentyp
//
// Straßentypen aus /def/world/road_look.template.sii (ETS2 1.61, Ausgabe von
// "osm2ets-writer looks"). Name laut Spieldaten in Klammern:
//   ger13 (ger hw 2 lanes one way tmpl)   ger16 (ger hw 3 lanes one way tmpl)
//   ger17 (ger hw2 ext one lane tmpl)
//   ger2  (ger hw exit one lane)          ger5  (ger road 1 one way)
//   ger9  (ger road 2 narrow one way)     ger1  (ger road 1 tmpl)
//   ger29 (ger road 2 no offset tmpl)
// ger4 = "ger road 1 minim" hat Spuren "no_vehicles" – nur für Wege ohne Lkw-/KI-Verkehr.
// Autobahn/Rampen: Look ger_1 und Randstücke ger_sh_15 wie in der SCS-Karte (Ausschnitt
// einer deutschen Anschlussstelle, ETS2 1.61); Rampen zusätzlich Variante it_lin.
// Übrige Fahrbahnvarianten und Looks werden noch nicht gesetzt (Standardwerte
// des Spiels) – das ist ungeprüft.
//
// Regeln werden von oben nach unten geprüft; die erste passende gewinnt.
// match-Felder (alle optional): highway, role, oneway, bridge, tunnel,
// lanes_min, lanes_max, ref (regulärer Ausdruck auf das ref-Tag), service,
// access (private, no; "none" = frei).
// Stil-Felder: road_type, terrain_left, terrain_right, resolution, show_in_ui_map,
// gps_avoid, secret, ai_vehicles
// (Normal | HighPoly | Superfine), left/right mit variant, look, traffic_rule,
// left_edge, right_edge.
{
  // width = Modellbreite (m). Für ger13/ger16/ger2 aus den Vorlagenmodellen (.pmg, ETS2 1.61)
  // gemessen, sonst geschätzt. offset = Verschiebung der ETS2-Linie nach rechts, damit die
  // Fahrspuren mittig auf der OSM-Linie liegen; edge_left = linker Modellrand ab OSM-Linie.
  // Annahme: Die Straßenlinie liegt bei x = 0 des Vorlagenmodells, +x = rechts.
  // Gemessen (x des Modells): ger13 Spuren −4,45…4,65, gesamt −4,5…8,0;
  // ger16 Spuren −8,94…4,66, gesamt −9,0…8,0; ger2 Spur −4,65…0,25, gesamt −5,5…2,5. boundary=false: keine
  // unsichtbare Randbegrenzung (Rampen ohne Prefab sind sonst nicht befahrbar).
  "default": { "road_type": "ger1", "width": 8, "boundary": false,
               "terrain_left": 20, "terrain_right": 20, "resolution": "HighPoly" },
  "rules": [
    // Nur in L5: Wege, die kein Lkw befahren soll. Breite geschätzt (Modelle nicht vermessen).
    //   ger37 = "ger r1 minim dirt" (Schotter-/Feldweg), ger4 = "ger road 1 minim"
    //   (schmale Asphaltstraße); beide mit Spuren "no_vehicles" (kein KI-Verkehr).
    { "name": "Feld-/Waldweg: Geheimstraße", "match": { "highway": ["track"] },
      "road_type": "ger37", "width": 4.5, "terrain_left": 6, "terrain_right": 6,
      "secret": true, "gps_avoid": true, "ai_vehicles": false },
    { "name": "Fuß-/Rad-/Reitweg, Fußgängerzone: nicht im Navi",
      "match": { "highway": ["path", "footway", "cycleway", "bridleway", "pedestrian"] },
      "road_type": "ger4", "width": 4.5, "terrain_left": 6, "terrain_right": 6,
      "show_in_ui_map": false, "gps_avoid": true, "ai_vehicles": false },
    { "name": "Parkplatzgasse, Grundstückszufahrt, Drive-in, Notzufahrt: nicht im Navi",
      "match": { "highway": ["service"], "service": ["parking_aisle", "driveway", "drive-through", "emergency_access"] },
      "road_type": "ger4", "width": 4.5, "terrain_left": 6, "terrain_right": 6,
      "show_in_ui_map": false, "gps_avoid": true, "ai_vehicles": false },
    { "name": "Gesperrter Service-Weg (access=no/private, z. B. Betriebszufahrt zur Autobahn): einspurig, nicht im Navi – nur ohne lanes > 1 / width > 5 m",
      "match": { "highway": ["service"], "access": ["no", "private"], "narrow_max_width": 5 },
      "road_type": "ger4", "width": 4.5, "terrain_left": 6, "terrain_right": 6,
      "show_in_ui_map": false, "gps_avoid": true, "ai_vehicles": false },
    // Rolle "ext" setzt der Writer: Straße zwischen Aufweitung und Teilung (bzw. Einmündung und
    // Spurende) einer Anschlussstelle, wenn dort ein Bauwerk liegt – wie in der SCS-Karte über
    // Brücken. ger17 = "ger hw2 ext one lane tmpl". Ihre Linie liegt am dreispurigen Prefab-Knoten
    // 4,5 m rechts der zweispurigen; Modell gemessen (ger_hw2_exit_one_lane.pmd, ETS2 1.61):
    // gesamt −9,0…8,0, Spuren −8,95…4,65 – wie ger16.
    { "name": "Autobahn mit Zusatzspur zwischen Anschluss-Prefabs", "match": { "role": ["ext"] },
      "road_type": "ger17", "width": 17, "model_center": -0.5, "offset": 0, "edge_left": 9, "terrain_left": 4, "terrain_right": 30,
      "railing_left": false,
      "right": { "look": "ger_1", "left_edge": "ger_sh_15", "right_edge": "ger_sh_15" } },
    // "ext3": dasselbe für 3 Spuren (zweispurige Ausfahrt, Prefab-Satz "hw3 double").
    // ger18 = "ger hw3 exit one lane tmpl" (4 Spuren). Gemessen (ger_hw3_exit_one_lane.pmd,
    // ETS2 1.61): gesamt −9,0…12,5, Spuren −8,95…9,15 (ger16 plus eine Spur rechts).
    { "name": "Autobahn 3 Spuren mit Zusatzspur zwischen Anschluss-Prefabs", "match": { "role": ["ext3"] },
      "road_type": "ger18", "width": 21.5, "model_center": 1.75, "offset": 0, "edge_left": 9, "terrain_left": 4, "terrain_right": 30,
      "railing_left": false,
      "right": { "look": "ger_1", "left_edge": "ger_sh_15", "right_edge": "ger_sh_15" } },
    { "name": "Autobahn 3+ Spuren", "match": { "highway": ["motorway", "trunk"], "oneway": true, "lanes_min": 3 },
      "road_type": "ger16", "width": 17, "model_center": -0.5, "offset": 2.17, "edge_left": 6.83, "terrain_left": 4, "terrain_right": 30,
      "railing_left": false,
      "right": { "look": "ger_1", "left_edge": "ger_sh_15", "right_edge": "ger_sh_15" } },
    { "name": "Autobahn / Kraftfahrstraße, Richtungsfahrbahn", "match": { "highway": ["motorway", "trunk"], "oneway": true },
      "road_type": "ger13", "width": 12.5, "model_center": 1.75, "offset": 0, "edge_left": 4.5, "terrain_left": 4, "terrain_right": 30,
      "railing_left": false,
      "right": { "look": "ger_1", "left_edge": "ger_sh_15", "right_edge": "ger_sh_15" } },
    // Rolle "link2" setzt der Writer: Rampe mit durchgehend mindestens 2 Spuren (OSM lanes), ohne
    // Anschluss an einspurige Rampen oder an Prefabs mit einspurigem Rampenknoten.
    { "name": "Autobahnrampe zweispurig", "match": { "role": ["link2"] },
      "road_type": "ger13", "width": 12.5, "model_center": 1.75, "offset": 0, "edge_left": 4.5, "terrain_left": 4, "terrain_right": 30,
      "railing_left": false,
      "right": { "look": "ger_1", "left_edge": "ger_sh_15", "right_edge": "ger_sh_15" } },
    { "name": "Autobahnrampe", "match": { "highway": ["motorway_link", "trunk_link"], "oneway": true },
      "road_type": "ger2", "width": 8, "model_center": -1.5, "offset": 2.2, "edge_left": 3.3, "terrain_left": 10, "terrain_right": 10,
      "right": { "look": "ger_1", "variant": "it_lin", "left_edge": "ger_sh_15", "right_edge": "ger_sh_15" } },
    { "name": "sonstige Rampe, einspurig", "match": { "highway": ["primary_link", "secondary_link", "tertiary_link"], "oneway": true },
      "road_type": "ger5", "width": 6.5, "terrain_left": 10, "terrain_right": 10 },
    { "name": "Einbahn zweispurig", "match": { "oneway": true, "lanes_min": 2 }, "road_type": "ger9", "width": 9 },
    { "name": "Einbahn", "match": { "oneway": true }, "road_type": "ger5", "width": 6.5 },
    { "name": "Vierspurig ohne Mitteltrennung", "match": { "oneway": false, "lanes_min": 4 }, "road_type": "ger29", "width": 15 },
    { "name": "Anschlussstraßen", "match": { "role": ["connector"] }, "road_type": "ger1",
      "terrain_left": 10, "terrain_right": 10 }
  ],
  // Brücken/Tunnel: kein Geländestreifen auf Fahrbahnhöhe – Gelände nur darunter
  // (flächiges Gelände auf Bodenhöhe). Dämme entstehen nur an den Zufahrten.
  // Geländer an den Brückenrändern: railing_01_ger (Token mod_ger_3) wie an Autobahnbrücken der
  // SCS-Karte (dort 9 m neben der Linie von ger17 – angenommen 1 m außerhalb des Modellrands).
  // Richtungsfahrbahnen (railing_left: false in ihren Regeln) nur außen, wie in der SCS-Karte.
  "bridge": { "terrain_left": 0, "terrain_right": 0, "railing": "mod_ger_3", "railing_offset": 1 },
  "tunnel": { "terrain_left": 0, "terrain_right": 0 },
  // Seitenstreifen nach OSM shoulder=* (Issue #3): asphaltierter 1-m-Rand ger_sh_as_15
  // ("ger_sh_asp_15", /road_template/ger/ger_sh_asphalt_15.pmd) statt des Banketts ger_sh_15.
  // Alle ger-Ränder (sh_15, sh_as_15, sh_dirt, sh_vill) sind gemessen 1,0 m breit und eben, sie
  // unterscheiden sich nur im Material. shoulder=no: wie ohne Angabe (Bankett). Autobahnen und
  // Rampen haben den Standstreifen in ihrer Vorlage; eine deutsche Vorlage ohne ist nicht bekannt.
  // Seiten in Fahrtrichtung der OSM-Linie (Annahme: left_edge/right_edge der Seite "right").
  "shoulder": {
    "yes": { "right": { "left_edge": "ger_sh_as_15", "right_edge": "ger_sh_as_15" } },
    "both": { "right": { "left_edge": "ger_sh_as_15", "right_edge": "ger_sh_as_15" } },
    "right": { "right": { "right_edge": "ger_sh_as_15" } },
    "left": { "right": { "left_edge": "ger_sh_as_15" } }
  },
  "shoulder_skip": ["motorway", "motorway_link", "trunk", "trunk_link"],
  // Ein Brückenkörper für beide Richtungsfahrbahnen eines Paars paralleler Autobahnbrücken, wie in
  // der SCS-Karte: Railing dlc_it_8 = /model2/railing/bridge/it_hw3_lanes_2m_offset_deep_it.pmd aus
  // dem ITALIA-DLC, an einer Richtungsfahrbahn, zur Gegenfahrbahn hin um den halben Abstand der
  // Linien + 2 m versetzt (SCS: 11 + 2 = 13 m). Seit v89 aus: unter den zweispurigen Paaren der
  // A 70 (Linien 12–15 m auseinander, das Modell ist rund 44 m breit) passte er nur von einer Seite;
  // jetzt bekommt jede Fahrbahn ihren Körper aus "bridge_bodies" (und die Karte braucht kein Italia).
  // Zum Einschalten die Zeile wieder aufnehmen; min_gap: kleinster Abstand der Linien (m).
  // "bridge_body": { "railing": "dlc_it_8", "extra_offset": 2, "min_gap": 18 },
  // Brückenkörper für alle Brücken, je Straßentyp ("*" = andere Typen). Railings mit Überbau,
  // Widerlagern (16 m tief) und Brüstung aus /def/world/railing.sii (bridge: true); Breiten aus den
  // .pmg-Modellen gemessen. Das Modell ist zur Außenseite der gewählten Straßenseite gespiegelt (so
  // passt dlc_it_8 der SCS-Karte: links, 13 m). Mit Versatz 0 liegen die Brüstungen bei allen drei
  // Autobahn-/Rampentypen 1,2–1,4 m außerhalb des Modellrands – so sind sie offenbar gedacht.
  //   dlc_no_5  shared_2lanes_x_1way  x −9,37…5,87   (ger13 links: −5,87…9,37 um −4,5…8,0)
  //   dlc_no_4  shared_3lanes_x_1way  x −9,25…10,23  (ger16 links: −10,23…9,25 um −9,0…8,0)
  //   dlc_no_14 shared_hw_exit        x −6,88…3,88   (ger2 rechts: −6,88…3,88 um −5,5…2,5)
  //   dlc_no_6  shared_simple         x −6,58…6,58   (Straße mittig auf der Linie, bis 11 m breit)
  // half_width: weiteste Ausdehnung ab der Linie; kreuzt eine Straße schräg darunter, wird die
  // Brücke so weit verlängert, dass sie an allen vier Ecken 3 m Platz bis zu den Widerlagern hat.
  // Ob diese Modelle zum Grundspiel gehören, ist ungeprüft (Token-Präfix dlc_no_); Ersatz aus dem
  // Grundspiel mit gleichen Maßen: 92 (2lanes_x_1way), 128 (3lanes_x_1way), 13 (simple).
  "bridge_bodies": {
    "ger13": { "railing": "dlc_no_5", "side": "left", "offset": 0, "half_width": 9.4 },
    "ger16": { "railing": "dlc_no_4", "side": "left", "offset": 0, "half_width": 10.3 },
    "ger17": { "railing": "dlc_no_4", "side": "left", "offset": 0, "half_width": 10.3 },
    "ger2": { "railing": "dlc_no_14", "side": "right", "offset": 0, "half_width": 6.9 },
    "*": { "railing": "dlc_no_6", "side": "right", "offset": 0, "max_width": 11, "half_width": 6.6 }
  },
  // Wege ohne Kfz-Zugang (access=private|no, nur in L5): Straßentyp wie sonst, aber nicht
  // auf Karte/Navi, Navi meidet, kein KI-Verkehr (z. B. Firmengelände, Privatstraßen).
  "restricted": { "show_in_ui_map": false, "gps_avoid": true, "ai_vehicles": false },
  // Sichtstücke (Rolle "visible"): Straßen höherer Stufen, die man von der Strecke aus sieht – unter
  // oder über einer Brücke, unmittelbar daneben. Nur ein Stück davon mit offenem Ende: Straßentyp
  // wie sonst (KI-Verkehr wie dort), aber nicht auf Karte/Navi, Navi meidet.
  "visible": { "show_in_ui_map": false, "gps_avoid": true },
  "map": { "normal_scale": null, "city_scale": null }
}
